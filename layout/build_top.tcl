# Builds the tile top cell in Magic: reads the macro GDS, loads tt_um_snn_mixed.mag (generated by make_top.py), extracts the
# netlist for LVS, writes build/<top>.magic.gds (intermediate) and ../lef/<top>.lef.
# Run from layout/build/ :  magic -dnull -noconsole -rcfile $PDK_ROOT/sky130A/libs.tech/magic/sky130A.magicrc ../build_top.tcl < /dev/null
set top tt_um_snn_mixed
addpath ..
addpath ../../analog/mux
gds read ../../digital/macro/dig_top.gds
load $top
select top cell
puts "TOP bbox: [box values]"
# hierarchical extraction and netlist (for LVS against tt_um_snn_mixed_golden.spice)
extract all
ext2spice lvs
ext2spice -o $top.spice
# the Magic GDS is only the intermediate: compose_gds.py swaps in the macro's own polygons (see there)
gds write $top.magic.gds
file mkdir ../../lef
lef write ../../lef/$top.lef -hide -pinonly
puts "BUILD_DONE"
quit -noprompt
